{
  "version": 2,
  "builds": [
    {
      "src": "yaumy-frontend/package.json",
      "use": "@vercel/next",
      "config": {
        "projectSettings": {
          "framework": "nextjs",
          "buildCommand": "npm run build",
          "outputDirectory": ".next",
          "installCommand": "npm install"
        }
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "yaumy-frontend/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "github": {
    "enabled": true,
    "autoAlias": false
  }
}