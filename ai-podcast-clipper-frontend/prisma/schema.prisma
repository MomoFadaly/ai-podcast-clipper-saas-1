generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  // shadowDatabaseUrl = "postgresql://postgres:mysecretpassword@localhost:5433/shadow_db_dev?schema=public" // Commenting out again
}

model Account {
  id                       String  @id
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  User                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Clip {
  id             String        @id
  s3Key          String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  uploadedFileId String?
  userId         String
  completedAt    DateTime?
  isCompleted    Boolean       @default(false)
  watchTime      Int           @default(0)
  thumbnailUrl   String?
  chunks         Json?
  UploadedFile   UploadedFile? @relation(fields: [uploadedFileId], references: [id], onDelete: Cascade)
  User           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([isCompleted])
  @@index([s3Key])
  @@index([uploadedFileId])
  @@index([uploadedFileId, userId])
  @@index([userId])
}

model Post {
  id          Int      @id @default(autoincrement())
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  createdById String
  User        User     @relation(fields: [createdById], references: [id])

  @@index([name])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UploadedFile {
  id           String   @id
  s3Key        String
  displayName  String?
  uploaded     Boolean  @default(false)
  status       String   @default("queued")
  createdAt    DateTime @default(now())
  updatedAt    DateTime
  userId       String
  thumbnailUrl String?
  duration     Int?
  transcript   Json?
  Clip         Clip[]
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([s3Key])
  @@index([status])
  @@index([userId, createdAt])
  @@index([userId])
  @@index([userId, status])
}

model User {
  id               String         @id
  name             String?
  email            String         @unique
  emailVerified    DateTime?
  password         String
  credits          Int            @default(10)
  stripeCustomerId String?        @unique
  image            String?
  Account          Account[]
  Clip             Clip[]
  Post             Post[]
  Session          Session[]
  UploadedFile     UploadedFile[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
