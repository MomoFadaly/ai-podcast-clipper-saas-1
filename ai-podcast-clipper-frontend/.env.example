# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Discord Provider
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Supabase PostgreSQL connection string format:
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?pgbouncer=true"

# AWS Configuration
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
S3_BUCKET_NAME="ai-podcast-clipper"

# Modal Endpoints
PROCESS_VIDEO_ENDPOINT=""
NEXT_PUBLIC_YOUTUBE_METADATA_ENDPOINT=""
NEXT_PUBLIC_YOUTUBE_PROCESS_ENDPOINT=""
NEXT_PUBLIC_FILE_PROCESS_ENDPOINT=""

# Chunkwise processor endpoints
CHUNKWISE_PROCESS_VIDEO_ENDPOINT=""
CHUNKWISE_PROCESS_VIDEO_ENDPOINT_AUTH=""

# Thumbnail generation endpoint (in chunkwise-processor app)
THUMBNAIL_GENERATION_ENDPOINT=""

# Authentication token for Modal endpoints
PROCESS_VIDEO_ENDPOINT_AUTH=""
